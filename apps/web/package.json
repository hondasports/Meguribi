{
  "name": "@meguribi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint server src vite.config.ts --deny-warnings",
    "format:check": "oxfmt --check src server vite.config.ts",
    "start": "tsx server/index.ts --production"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
