{
  "name": "@meguribi/devin-acp-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "smoke": "tsx src/cli.ts",
    "smoke:devin-acp": "tsx src/compatibility-smoke.ts",
    "smoke:devin-acp:fake": "tsx src/compatibility-smoke.ts --fake",
    "diagnose": "tsx src/diagnose-cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
