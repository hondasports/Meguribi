{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@meguribi/core": ["../core/src/index.ts"],
      "@meguribi/process": ["../process/src/index.ts"],
      "@meguribi/config": ["../config/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/devin/fixtures/**"]
}
